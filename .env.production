# BEETRONIC OS - Production Environment Configuration

# Server
NODE_ENV=production
PORT=3000

# Database - PostgreSQL (production)
# Update with your actual PostgreSQL credentials
DATABASE_URL=postgresql://beetronic_user:your_secure_password@localhost:5432/beetronic_os

# JWT Secrets - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_64_char_hex_string_here
JWT_EXPIRY=24h
REFRESH_TOKEN_SECRET=your_64_char_hex_string_here
REFRESH_TOKEN_EXPIRY=7d

# 2FA Configuration
TOTP_WINDOW=2

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Frontend URL (for CORS)
FRONTEND_URL=https://your-domain.com

# Logging
LOG_LEVEL=info
